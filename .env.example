# Copy this file to `.env` and fill it in:  cp .env.example .env
#
# UCAS credentials ----------------------------------------------------------
UCAS_USERNAME=you@mails.ucas.ac.cn
UCAS_PASSWORD=your-password

# Feishu notifications -------------------------------------------------------
# In a Feishu group: Settings -> Group bots -> Add bot -> Custom bot. Copy the
# webhook (https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx).
UCAS_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# Set this only if the bot uses the "signature" (签名校验) security mode:
# UCAS_FEISHU_SECRET=xxxxxxxxxxxxxxxx

# Behaviour -----------------------------------------------------------------
# Run a pass immediately when the container starts (default: 1).
UCAS_RUN_ON_START=1

# Image build ---------------------------------------------------------------
# Debian apt mirror used while building the image (default: deb.debian.org).
# On mainland networks set a local one to avoid slow apt downloads, e.g.:
# APT_MIRROR=mirrors.aliyun.com
